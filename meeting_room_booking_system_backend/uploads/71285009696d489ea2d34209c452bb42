<svg width="1200" height="800" viewBox="0 0 1200 800" xmlns="http://www.w3.org/2000/svg">
<defs>
<linearGradient id="bg" x1="0" y1="0" x2="1" y2="1">
<stop offset="0%" stop-color="#0f172a"/>
<stop offset="100%" stop-color="#1e293b"/>
</linearGradient>
<linearGradient id="line" x1="0" y1="0" x2="1" y2="0">
<stop offset="0%" stop-color="#f59e0b"/>
<stop offset="100%" stop-color="#ef4444"/>
</linearGradient>
</defs>

<rect width="1200" height="800" fill="url(#bg)"/>

<text x="70" y="90" fill="#f8fafc" font-size="40" font-family="Arial, PingFang SC, Microsoft YaHei, sans-serif" font-weight="700">伊朗战争对石油价格影响示意图</text>
<text x="70" y="130" fill="#cbd5e1" font-size="22" font-family="Arial, PingFang SC, Microsoft YaHei, sans-serif">通俗理解：冲突升级 → 市场担心供给中断 → 国际油价通常先涨</text>

<rect x="60" y="170" width="1080" height="560" rx="28" fill="#111827" opacity="0.95"/>

<line x1="130" y1="660" x2="1080" y2="660" stroke="#94a3b8" stroke-width="3"/>
<line x1="130" y1="250" x2="130" y2="660" stroke="#94a3b8" stroke-width="3"/>

<g stroke="#334155" stroke-width="1">
<line x1="130" y1="580" x2="1080" y2="580"/>
<line x1="130" y1="500" x2="1080" y2="500"/>
<line x1="130" y1="420" x2="1080" y2="420"/>
<line x1="130" y1="340" x2="1080" y2="340"/>
<line x1="130" y1="260" x2="1080" y2="260"/>
</g>

<g fill="#cbd5e1" font-size="20" font-family="Arial, PingFang SC, Microsoft YaHei, sans-serif">
<text x="70" y="666">70</text>
<text x="70" y="586">80</text>
<text x="70" y="506">90</text>
<text x="60" y="426">100</text>
<text x="60" y="346">110</text>
<text x="60" y="266">120</text>
</g>

<g fill="#cbd5e1" font-size="20" font-family="Arial, PingFang SC, Microsoft YaHei, sans-serif">
<text x="150" y="705">冲突前</text>
<text x="330" y="705">紧张升级</text>
<text x="530" y="705">袭击扩大</text>
<text x="745" y="705">航运担忧</text>
<text x="955" y="705">缓和/回落</text>
</g>

<polyline fill="none" stroke="url(#line)" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"
points="180,620 380,540 570,420 790,320 1000,390"/>

<g>
<circle cx="180" cy="620" r="10" fill="#fbbf24"/>
<circle cx="380" cy="540" r="10" fill="#f59e0b"/>
<circle cx="570" cy="420" r="10" fill="#fb7185"/>
<circle cx="790" cy="320" r="10" fill="#ef4444"/>
<circle cx="1000" cy="390" r="10" fill="#f97316"/>
</g>

<g fill="#f8fafc" font-size="18" font-family="Arial, PingFang SC, Microsoft YaHei, sans-serif" font-weight="700">
<text x="160" y="600">75</text>
<text x="360" y="520">85</text>
<text x="550" y="400">100</text>
<text x="770" y="300">112</text>
<text x="980" y="370">104</text>
</g>

<rect x="835" y="200" width="255" height="120" rx="18" fill="#1d4ed8" opacity="0.95"/>
<text x="860" y="242" fill="#eff6ff" font-size="24" font-family="Arial, PingFang SC, Microsoft YaHei, sans-serif" font-weight="700">核心逻辑</text>
<text x="860" y="278" fill="#dbeafe" font-size="20" font-family="Arial, PingFang SC, Microsoft YaHei, sans-serif">不是油马上变少，</text>
<text x="860" y="308" fill="#dbeafe" font-size="20" font-family="Arial, PingFang SC, Microsoft YaHei, sans-serif">而是市场先担心会变少。</text>

<rect x="170" y="210" width="280" height="84" rx="16" fill="#065f46" opacity="0.95"/>
<text x="195" y="248" fill="#ecfdf5" font-size="24" font-family="Arial, PingFang SC, Microsoft YaHei, sans-serif" font-weight="700">供给风险溢价上升</text>
<text x="195" y="278" fill="#d1fae5" font-size="18" font-family="Arial, PingFang SC, Microsoft YaHei, sans-serif">尤其影响国际原油期货价格</text>

<rect x="470" y="560" width="300" height="84" rx="16" fill="#7c2d12" opacity="0.95"/>
<text x="495" y="598" fill="#fff7ed" font-size="24" font-family="Arial, PingFang SC, Microsoft YaHei, sans-serif" font-weight="700">若局势缓和，价格会回吐</text>
<text x="495" y="628" fill="#ffedd5" font-size="18" font-family="Arial, PingFang SC, Microsoft YaHei, sans-serif">但通常难立刻回到起点</text>

<text x="70" y="760" fill="#94a3b8" font-size="18" font-family="Arial, PingFang SC, Microsoft YaHei, sans-serif">注：此图为解释逻辑的示意图，不代表实时市场报价。</text>
</svg>